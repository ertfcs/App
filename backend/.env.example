# Copia questo file in backend/.env e compila i valori.
MONGO_URL=mongodb://localhost:27017
DB_NAME=matteo
JWT_SECRET=cambia-questa-stringa-lunga-e-casuale
ADMIN_USERNAME=Matteo
ADMIN_PASSWORD=cambia-password
CORS_ORIGINS=*

# AI (Carmelo, marketing, Google Business): chiave tua da console.anthropic.com
ANTHROPIC_API_KEY=
# Modello Claude (facoltativo)
CLAUDE_MODEL=claude-opus-5-5

# Cartella dove salvare PDF e foto caricate (facoltativo, default backend/storage)
